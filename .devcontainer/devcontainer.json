{
  "name": "AI Portfolio Manager",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "nohup streamlit run app/Home.py > /dev/null 2>&1 &",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "onAutoForward": "openPreview" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-vsliveshare.vsliveshare"]
    }
  }
}
